# Dominio del frontend permitido por CORS (varios separados por coma)
FRONTEND_URL=http://localhost:3000

# Envío del formulario de contacto con Resend (https://resend.com, plan gratuito)
RESEND_API_KEY=
# Correo donde llegan los mensajes (con onboarding@resend.dev solo funciona con el correo de tu cuenta de Resend)
CONTACT_TO_EMAIL=
# Opcional: remitente verificado en Resend
# CONTACT_FROM_EMAIL=Portafolio <contacto@tudominio.com>
